// fontName(小写) → (orderingInfo, cmapB64, widthB64)
func cjkFontData(name: String): ?(String, String, String) {
    match (name.toAsciiLower()) {
        case "stsong-light" => Some((STSong_Light_DESC, STSong_Light_CMAP, STSong_Light_W))
        case "msung-light" => Some((MSung_Light_DESC, MSung_Light_CMAP, MSung_Light_W))
        case "kozminpro-regular" => Some((KozMinPro_Regular_DESC, KozMinPro_Regular_CMAP, KozMinPro_Regular_W))
        case "hysmyeongjo-medium" => Some((HYSMyeongJo_Medium_DESC, HYSMyeongJo_Medium_CMAP, HYSMyeongJo_Medium_W))
        case _ => None
    }
}