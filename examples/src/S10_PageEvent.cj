package pdf_cj_examples

import pdf_cj.api.{Document, Paragraph, Phrase, Chunk}
import pdf_cj.core.{PdfWriter, PdfContentByte, PdfPageEventHelper}
import pdf_cj.text.{BaseFont, Font, FontStyle, Color, Alignment}
import pdf_cj.util.{PageSize, Rectangle}
import std.fs.{File, OpenMode, Path}

let _s10_FONT = "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
let _s10_OUT  = "output/"



// Named page event class - must be named, not anonymous
class S10PageEvent <: PdfPageEventHelper {
    public override func onOpenDocument(w: PdfWriter, d: Document): Unit {
        println("  [S10 Event] onOpenDocument")
    }

    public override func onCloseDocument(w: PdfWriter, d: Document): Unit {
        println("  [S10 Event] onCloseDocument. Total pages: ${w.pageNumber - 1}")
    }

    public override func onStartPage(w: PdfWriter, d: Document): Unit {
        println("  [S10 Event] onStartPage: page ${w.pageNumber}")
    }

    public override func onEndPage(w: PdfWriter, d: Document): Unit {
        let cb = w.getDirectContent()
        let helvBf = newHelvBf()
        let helvName = w.addFont(helvBf)
        cb.saveState()

        // Draw header bar
        cb.setColorFill(Color(50, 50, 150))
        cb.rectangle(36.0, 810.0, 522.0, 20.0)
        cb.fill()

        cb.beginText()
        cb.setFontAndSize(helvBf, helvName, 10.0)
        cb.setColorFill(Color(255, 255, 255))
        cb.setTextMatrix(40.0, 815.0)
        cb.showText("S10: Page Event Demo")
        cb.showTextAligned(PdfContentByte.ALIGN_RIGHT, "Page ${w.pageNumber}", 558.0, 815.0, 0.0)
        cb.endText()

        // Draw footer line
        cb.setColorStroke(Color(150, 150, 150))
        cb.setLineWidth(0.5)
        cb.moveTo(36.0, 36.0)
        cb.lineTo(558.0, 36.0)
        cb.stroke()

        cb.beginText()
        cb.setFontAndSize(helvBf, helvName, 8.0)
        cb.setColorFill(Color(100, 100, 100))
        cb.setTextMatrix(36.0, 25.0)
        cb.showText("Generated by OpenPDF 2.0.3 — S10 Page Event Demo")
        cb.showTextAligned(PdfContentByte.ALIGN_RIGHT, "Page ${w.pageNumber}", 558.0, 25.0, 0.0)
        cb.endText()

        cb.restoreState()
        println("  [S10 Event] onEndPage: page ${w.pageNumber}")
    }
}

func s10_pageEvent(): Unit {
    println("S10: Page Event Demo")
    let cjkBf = newCjkBf()
    let helvBf = newHelvBf()
    try {
        let doc = Document(PageSize.A4, 72.0, 72.0, 90.0, 60.0)
        let file = File(Path(_s10_OUT + "cj_s10_pageevent.pdf"), OpenMode.Write)
        let writer = PdfWriter.getInstance(doc, file)

        // Attach the page event
        writer.setPageEvent(S10PageEvent())
        doc.open()

        var titlePara = Paragraph("S10: Page Event Demo", Font(cjkBf, 18.0, FontStyle.Bold))
        titlePara.setAlignment(Alignment.Center)
        titlePara.setSpacingAfter(20.0)
        doc.add(titlePara)

        doc.add(Paragraph("This document demonstrates PdfPageEventHelper callbacks.", Font(helvBf, 12.0)))
        doc.add(Paragraph("The header shows the document title and page number.", Font(helvBf, 11.0)))
        doc.add(Paragraph("The footer shows the generator info and page number.", Font(helvBf, 11.0)))

        doc.add(Paragraph("章节一 Chapter 1", Font(cjkBf, 14.0, FontStyle.Bold)))
        doc.add(Paragraph("This is the content of Chapter 1. " +
            "The onChapter callback fires when a Chapter element is added. " +
            "Section callbacks fire for section elements.", Font(helvBf, 11.0)))

        // Long content to force multiple pages
        let lorem = "The quick brown fox jumps over the lazy dog. " +
            "Pack my box with five dozen liquor jugs. "
        for (i in 1..9) {
            var p = Paragraph("Paragraph ${i}: " + lorem + lorem, Font(helvBf, 11.0))
            p.setSpacingAfter(8.0)
            doc.add(p)
        }

        // Force page 2
        doc.newPage()
        doc.add(Paragraph("章节二 Chapter 2 — Page 2", Font(cjkBf, 14.0, FontStyle.Bold)))
        doc.add(Paragraph("Content of Chapter 2 on page 2.", Font(helvBf, 12.0)))
        for (i in 1..9) {
            doc.add(Paragraph("Page 2, Para ${i}: " + lorem, Font(helvBf, 11.0)))
        }

        // Force page 3
        doc.newPage()
        doc.add(Paragraph("章节三 Chapter 3 — Page 3", Font(cjkBf, 14.0, FontStyle.Bold)))
        doc.add(Paragraph("Content of Chapter 3 on page 3.", Font(helvBf, 12.0)))
        doc.add(Paragraph("CJK text: 这是第三页的中文内容，用于测试页面事件在多页文档中的正常工作。", Font(cjkBf, 12.0)))

        doc.close()
        println("  S10 done: ${_s10_OUT}cj_s10_pageevent.pdf")
    } catch (e: Exception) {
        println("  ✗ S10: ${e.message}")
    }
}
