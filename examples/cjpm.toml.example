[package]
name = "pdf_cj_examples"
version = "0.1.0"
description = "Examples for pdf-cj (S01-S23, OpenPDF 对照)"
cjc-version = "1.0.4"
output-type = "executable"
c-arguments = ["-Woff", "unused"]

[dependencies]
pdf_cj = { path = ".." }

# openHiTLS FFI 配置
#
# 推荐使用 ./build.sh 脚本进行编译，它会自动检测 HiTLS 库位置并生成本文件。
#
# 如果要直接使用 cjpm build / cjpm run，需要把下面的路径改为你的实际路径。
# 注意：cjpm 不支持 ~ 符号，必须使用绝对路径。
#
# 常见安装位置：
#   - /home/YOUR_USERNAME/.local/lib/hitls
#   - /usr/local/lib
[ffi.c]
hitls_crypto = { path = "/path/to/your/hitls/lib" }
hitls_bsl = { path = "/path/to/your/hitls/lib" }
boundscheck = { path = "/path/to/your/hitls/lib" }
