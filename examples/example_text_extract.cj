/**
 * PDF-CJ TextExtractor 示例
 * 演示如何从 PDF 文件中提取纯文本内容，包含阅读顺序验证和表格文本提取
 */
package pdf_cj_examples

import std.fs.{File, OpenMode, Path}
import pdf_cj.api.{Document, Paragraph, Phrase}
import pdf_cj.core.{PdfWriter, PdfContentByte}
import pdf_cj.reader.{PdfReader, ContentStreamParser, TextExtractor}
import pdf_cj.table.{PdfPTable, PdfPCell}
import pdf_cj.text.{BaseFont, Font, FontStyle, Color, Alignment}
import pdf_cj.util.PageSize

// 创建一个包含多段文字的源 PDF
func createTextPdf(outputPath: String): Unit {
    let document = Document(PageSize.A4)
    let file = File(Path(outputPath), OpenMode.Write)
    let writer = PdfWriter.getInstance(document, file)
    document.open()

    let cb = writer.getDirectContent()

    // 标题：大号字体，页面顶部
    cb.beginText()
    cb.setFontAndSize("Helvetica-Bold", 24.0)
    cb.setTextMatrix(100.0, 750.0)
    cb.showText("PDF Text Extraction Demo")
    cb.endText()

    // 第一行正文
    cb.beginText()
    cb.setFontAndSize("Helvetica", 14.0)
    cb.setTextMatrix(100.0, 700.0)
    cb.showText("Line 1: Hello from PDF-CJ!")
    cb.endText()

    // 第二行正文（注意：内容流中先写这行，但 y 更低）
    cb.beginText()
    cb.setFontAndSize("Helvetica", 14.0)
    cb.setTextMatrix(100.0, 660.0)
    cb.showText("Line 2: Text extraction preserves reading order.")
    cb.endText()

    // 页面底部注释（内容流中最后写，但 y 最低）
    cb.beginText()
    cb.setFontAndSize("Helvetica", 10.0)
    cb.setTextMatrix(100.0, 100.0)
    cb.showText("Footer: Generated by PDF-CJ")
    cb.endText()

    document.close()
    println("  源 PDF 已创建：${outputPath}")
}

// 示例1：提取单页文本（验证阅读顺序）
func example_extract_page(): Unit {
    println("\n--- 示例1：提取单页文本 ---")

    let sourcePath = "output/text_source.pdf"
    createTextPdf(sourcePath)

    let reader = PdfReader(sourcePath)
    println("  页数：${reader.getNumberOfPages()}")

    let frags = ContentStreamParser.parse(reader.getPageContent(1))
    println("  文本片段数：${frags.size}")
    println("  各片段（已按阅读顺序排列）：")
    for (i in 0..frags.size) {
        let f = frags[i]
        println("    [${i + 1}] y=${Int32(f.y)} x=${Int32(f.x)} \"${f.text}\"")
    }

    let text = ContentStreamParser.assembleText(frags)
    println("  提取结果：")
    println("  ----------")
    println(text)
    println("  ----------")

    reader.close()
}

// 示例2：使用 TextExtractor 高层 API
func example_text_extractor(): Unit {
    println("\n--- 示例2：TextExtractor 高层 API ---")

    let reader = PdfReader("output/text_source.pdf")

    let text = TextExtractor.extractPage(reader, 1)
    println("  第1页文本（共 ${text.size} 字符）：")
    println("  ----------")
    println(text)
    println("  ----------")

    reader.close()
}

// 创建复杂双页 PDF：第1页为段落文字，第2页为数据表格
func createComplexPdf(outputPath: String): Unit {
    let helvetica     = BaseFont.createFont()
    let helveticaBold = BaseFont.createFont(BaseFont.HELVETICA_BOLD, BaseFont.WINANSI)
    let titleFont = Font(helveticaBold, 20.0)
    let headFont  = Font(helveticaBold, 11.0)
    let bodyFont  = Font(helvetica, 12.0)
    let noteFont  = Font(helvetica, 10.0)

    let document = Document(PageSize.A4)
    let file = File(Path(outputPath), OpenMode.Write)
    let writer = PdfWriter.getInstance(document, file)
    document.open()

    // ── 第1页：段落文字 ──────────────────────────────────────────────
    let pageTitle = Paragraph("Q1 2024 Sales Report", titleFont)
    pageTitle.setAlignment(Alignment.Center)
    pageTitle.setSpacingAfter(24.0)
    document.add(pageTitle)

    let intro = Paragraph(
        "This report summarizes product sales performance for Q1 2024. " +
        "Three product lines showed strong growth across all regions, " +
        "with total revenue exceeding targets by 12%.",
        bodyFont
    )
    intro.setSpacingAfter(12.0)
    document.add(intro)

    let detail = Paragraph(
        "Widget A led unit volume while Widget B achieved the highest " +
        "per-unit revenue. Widget C maintained the broadest market reach.",
        bodyFont
    )
    detail.setSpacingAfter(8.0)
    document.add(detail)

    let note = Paragraph("All figures are preliminary and subject to audit.", noteFont)
    document.add(note)

    // ── 第2页：数据表格 ──────────────────────────────────────────────
    document.newPage()

    let tableTitle = Paragraph("Sales Data by Product", titleFont)
    tableTitle.setSpacingAfter(16.0)
    document.add(tableTitle)

    let table = PdfPTable(3)
    table.setWidthPercentage(85.0)
    table.setSpacingBefore(8.0)

    // 表头（灰色底）
    let headerBg = Color(180, 180, 180)
    for (text in ["Product", "Units Sold", "Revenue ($)"]) {
        let cell = PdfPCell(Phrase(text, headFont))
        cell.setBackgroundColor(headerBg)
        cell.setPadding(6.0)
        table.addCell(cell)
    }

    // 数据行
    let rows = [
        ["Widget A", "1,250", "62,500"],
        ["Widget B", "980",   "78,400"],
        ["Widget C", "2,100", "42,000"]
    ]
    for (row in rows) {
        for (cell in row) {
            let c = PdfPCell(Phrase(cell, bodyFont))
            c.setPadding(5.0)
            table.addCell(c)
        }
    }

    // 合计行（浅灰底）
    let totalBg = Color(220, 220, 220)
    for (text in ["Total", "4,330", "182,900"]) {
        let cell = PdfPCell(Phrase(text, headFont))
        cell.setBackgroundColor(totalBg)
        cell.setPadding(6.0)
        table.addCell(cell)
    }

    document.add(table)

    let footer = Paragraph("Note: Revenue in USD. Figures rounded to nearest dollar.", noteFont)
    footer.setSpacingBefore(12.0)
    document.add(footer)

    document.close()
    println("  复杂 PDF 已创建：${outputPath}")
}

// 示例3：从含有表格的多页 PDF 中提取文字
func example_extract_multipage(): Unit {
    println("\n--- 示例3：含表格的多页 PDF 文本提取 ---")

    let pdfPath = "output/text_complex.pdf"
    createComplexPdf(pdfPath)

    let reader = PdfReader(pdfPath)
    let totalPages = reader.getNumberOfPages()
    println("  文档共 ${totalPages} 页")

    for (p in 1..(totalPages + 1)) {
        let pageNum = Int32(p)
        let text = TextExtractor.extractPage(reader, pageNum)
        println("\n  ── 第 ${p} 页（共 ${text.size} 字符）──")
        println(text)
    }

    println("\n  ── 全文提取 ──")
    let allText = TextExtractor.extractAll(reader)
    println("  总字符数：${allText.size}")
    println(allText)

    reader.close()
}

main(): Int64 {
    println("=== PDF 文本提取示例 ===")

    try {
        example_extract_page()
        example_text_extractor()
        example_extract_multipage()
        println("\n示例全部完成！")
    } catch (e: Exception) {
        println("示例执行出错：${e.message}")
    }
    0
}
